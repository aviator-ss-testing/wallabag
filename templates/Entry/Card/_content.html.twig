{% if is_granted('VIEW', entry) %}
    <a href="{{ path('view', {'id': entry.id}) }}" title="{{ entry.title|striptags|e('html_attr') }}" class="wbg-card__title">
        {{ entry.title|striptags|default('entry.default_title'|trans)|raw }}
    </a>
{% else %}
    <span class="wbg-card__title">{{ entry.title|striptags|default('entry.default_title'|trans)|raw }}</span>
{% endif %}

<div class="wbg-card__domain">
    <a href="{{ entry.url|e }}" target="_blank" title="{{ entry.domainName|removeWww }}">{{ entry.domainName|removeWww }}</a>
</div>
