{% set current_path = app.request.requesturi %}
<div class="wbg-card__kebab">
    <button class="wbg-kebab-btn dropdown-trigger" data-target="kebab-{{ entry.id }}" data-controller="materialize--dropdown">
        <i class="material-icons">more_vert</i>
    </button>
    <ul id="kebab-{{ entry.id }}" class="dropdown-content">
        {% if is_granted('LIST_ENTRIES') %}
            <li>
                <a href="{{ path('same_domain', {'id': entry.id, redirect: current_path}) }}" data-action="same_domain" data-entry-id="{{ entry.id }}">
                    <i class="material-icons">language</i>
                    {{ 'entry.list.show_same_domain'|trans }}
                </a>
            </li>
        {% endif %}
        {% if is_granted('ARCHIVE', entry) %}
            <li>
                <form action="{{ path('archive_entry', {'id': entry.id, redirect: current_path}) }}" method="post">
                    <input type="hidden" name="token" value="{{ csrf_token('archive-entry') }}"/>
                    <button type="submit" class="btn-link">
                        <i class="material-icons">{% if entry.isArchived == 0 %}done{% else %}unarchive{% endif %}</i>
                        {{ 'entry.list.toogle_as_read'|trans }}
                    </button>
                </form>
            </li>
        {% endif %}
        {% if is_granted('STAR', entry) %}
            <li>
                <form action="{{ path('star_entry', {'id': entry.id, redirect: current_path}) }}" method="post">
                    <input type="hidden" name="token" value="{{ csrf_token('star-entry') }}"/>
                    <button type="submit" class="btn-link">
                        <i class="material-icons">{% if entry.isStarred == 0 %}star_border{% else %}star{% endif %}</i>
                        {{ 'entry.list.toogle_as_star'|trans }}
                    </button>
                </form>
            </li>
        {% endif %}
        {% if is_granted('DELETE', entry) %}
            <li>
                <form action="{{ path('delete_entry', {'id': entry.id, redirect: current_path}) }}" method="post">
                    <input type="hidden" name="token" value="{{ csrf_token('delete-entry') }}"/>
                    <button type="submit" class="btn-link" onclick="return confirm('{{ 'entry.confirm.delete'|trans|escape('js') }}')">
                        <i class="material-icons">delete</i>
                        {{ 'entry.list.delete'|trans }}
                    </button>
                </form>
            </li>
        {% endif %}
    </ul>
</div>
