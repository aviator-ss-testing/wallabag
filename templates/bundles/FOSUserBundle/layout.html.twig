{% extends "layout.html.twig" %}

{% block title %}{{ 'security.login.page_title'|trans }}{% endblock %}

{% block body_class %}login-page{% endblock %}

{% block menu %}{% endblock %}
{% block messages %}{% endblock %}

{% block content %}
<main class="login-main">
    <div class="login-logo-lockup">
        <img src="{{ asset('img/logo-square.svg') }}" alt="wallabag" width="40" height="40" />
        <span class="login-wordmark">wallabag</span>
    </div>

    <div class="login-form-wrap">
        {% block fos_user_content %}
        {% endblock fos_user_content %}

        <div class="login-locale-switcher">
            {% set current_locale = app.request.locale|upper %}
            {% if supported_locales is defined %}
                {% for locale in supported_locales %}
                    {% if not loop.first %}<span class="locale-divider">·</span>{% endif %}
                    {% if locale|upper == current_locale %}
                        <span class="locale-current">{{ locale|upper }}</span>
                    {% else %}
                        <form action="{{ path('changeLocale', {'language': locale}) }}" method="post" class="inline-block">
                            <input type="hidden" name="token" value="{{ csrf_token('change-locale') }}"/>
                            <button type="submit" class="btn-locale">{{ locale|upper }}</button>
                        </form>
                    {% endif %}
                {% endfor %}
            {% else %}
                {% set locales = [{'code': 'de', 'label': 'DE'}, {'code': 'en', 'label': 'EN'}, {'code': 'fr', 'label': 'FR'}] %}
                {% for locale in locales %}
                    {% if not loop.first %}<span class="locale-divider">·</span>{% endif %}
                    {% if locale.code|upper == current_locale %}
                        <span class="locale-current">{{ locale.label }}</span>
                    {% else %}
                        <form action="{{ path('changeLocale', {'language': locale.code}) }}" method="post" class="inline-block">
                            <input type="hidden" name="token" value="{{ csrf_token('change-locale') }}"/>
                            <button type="submit" class="btn-locale">{{ locale.label }}</button>
                        </form>
                    {% endif %}
                {% endfor %}
            {% endif %}
        </div>
    </div>
</main>
{% endblock %}

{% block footer %}
{% endblock %}
