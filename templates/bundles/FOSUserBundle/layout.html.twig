{% extends "layout.html.twig" %}

{% block title %}{{ 'security.login.page_title'|trans }}{% endblock %}

{% block body_class %}login{% endblock %}

{% block menu %}{% endblock %}
{% block messages %}{% endblock %}

{% block content %}
<div class="login-page" style="min-height: 100vh; display: flex; align-items: center; justify-content: center; position: relative;">
    <div class="login-branding">
        <div class="login-logo-box">
            <img src="{{ asset('img/logo-square.svg') }}" alt="wallabag logo" />
        </div>
        <span class="login-wordmark">wallabag</span>
    </div>

    <div class="login-form-container">
        {% block fos_user_content %}
        {% endblock fos_user_content %}
    </div>
</div>
{% endblock %}

{% block footer %}
{% endblock %}
