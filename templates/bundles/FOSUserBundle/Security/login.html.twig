{% extends "@FOSUser/layout.html.twig" %}

{% block fos_user_content %}
<form action="{{ path('fos_user_security_check') }}" method="post" name="loginform">

    {% if error %}
        <p class="hidden" data-controller="materialize--toast">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
    {% endif %}

    {% for flash_message in app.session.flashbag.get('notice') %}
        <p class="hidden" data-controller="materialize--toast">{{ flash_message }}</p>
    {% endfor %}

    <h1 class="login-heading">Welcome back</h1>
    <p class="login-subheading">Sign in to access your reading list</p>

    <div class="form-field">
        <label for="username">{{ 'security.login.username'|trans }}</label>
        <input type="text" id="username" name="_username" value="{{ last_username }}" autofocus />
    </div>

    <div class="form-field form-field--password" data-controller="password-visibility">
        <label for="password">{{ 'security.login.password'|trans }}</label>
        <input type="password" id="password" name="_password" data-password-visibility-target="input" />
        <button type="button" class="password-toggle" aria-label="Toggle password visibility" data-action="click->password-visibility#toggle">
            <i class="material-icons password-toggle__icon" data-password-visibility-target="icon">visibility</i>
        </button>
    </div>

    <div class="form-field form-field--checkbox">
        <label for="remember_me">
            <input type="checkbox" id="remember_me" name="_remember_me" checked/>
            <span>{{ 'security.login.keep_logged_in'|trans }}</span>
        </label>
    </div>

    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}" />

    <button class="btn-login" type="submit" name="send">
        {{ 'security.login.submit'|trans }}
    </button>

    {% if registration_enabled %}
        <div class="login-register">
            <a href="{{ path('fos_user_registration_register') }}">{{ 'security.login.register'|trans }}</a>
        </div>
    {% endif %}

    <div class="login-forgot-password">
        <a href="{{ path('fos_user_resetting_request') }}">{{ 'security.login.forgot_password'|trans }}</a>
    </div>

</form>
{% endblock fos_user_content %}
