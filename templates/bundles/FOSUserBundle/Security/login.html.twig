{% extends "@FOSUser/layout.html.twig" %}

{% block fos_user_content %}
    {% if error %}
        <p class="hidden" data-controller="materialize--toast">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
    {% endif %}

    {% for flash_message in app.session.flashbag.get('notice') %}
        <p class="hidden" data-controller="materialize--toast">{{ flash_message }}</p>
    {% endfor %}

    <div style="text-align: center; margin-bottom: 2rem;">
        <h1 style="font-size: 1.75rem; font-weight: 700; margin: 0 0 0.5rem;">Welcome back</h1>
        <p class="login-subheading" style="font-size: 0.9rem; margin: 0;">Sign in to access your reading list</p>
    </div>

    <form action="{{ path('fos_user_security_check') }}" method="post" name="loginform">
        <div style="margin-bottom: 1rem;">
            <label for="username" class="login-label" style="display: block; font-size: 0.875rem; margin-bottom: 0.375rem; font-weight: 500;">Username</label>
            <input
                type="text"
                id="username"
                name="_username"
                value="{{ last_username }}"
                placeholder="Enter your username"
                autofocus
                class="login-input"
                style="display: block; width: 100%; box-sizing: border-box; height: 2.75rem; padding: 0 0.75rem; font-size: 0.875rem; border-radius: 0.5rem;"
            />
        </div>

        <div style="margin-bottom: 1rem;">
            <label for="password" class="login-label" style="display: block; font-size: 0.875rem; margin-bottom: 0.375rem; font-weight: 500;">Password</label>
            <div class="login-password-wrapper" style="position: relative;">
                <input
                    type="password"
                    id="password"
                    name="_password"
                    placeholder="Enter your password"
                    class="login-input"
                    style="display: block; width: 100%; box-sizing: border-box; height: 2.75rem; padding: 0 2.75rem 0 0.75rem; font-size: 0.875rem; border-radius: 0.5rem;"
                />
                <button
                    type="button"
                    class="login-eye-toggle"
                    style="position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; padding: 0; display: flex; align-items: center;"
                    onclick="(function(btn){var inp=btn.previousElementSibling;inp.type=inp.type==='password'?'text':'password';})(this)"
                    aria-label="Toggle password visibility"
                >
                    <i class="material-icons" style="font-size: 1.125rem;">visibility</i>
                </button>
            </div>
        </div>

        <div style="margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <input type="checkbox" id="remember_me" name="_remember_me" checked style="width: 1rem; height: 1rem; cursor: pointer;" />
            <label for="remember_me" class="login-remember-label" style="font-size: 0.875rem; cursor: pointer; margin: 0;">{{ 'security.login.keep_logged_in'|trans }}</label>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}" />

        <button
            type="submit"
            name="send"
            class="login-submit"
            style="display: block; width: 100%; height: 2.75rem; font-size: 0.9375rem; font-weight: 500; border: none; border-radius: 0.5rem; cursor: pointer;"
        >
            {{ 'security.login.submit'|trans }} →
        </button>
    </form>

    <div style="margin-top: 1.5rem; text-align: center;">
        <a href="{{ path('fos_user_resetting_request') }}" class="login-link" style="font-size: 0.875rem;">{{ 'security.login.forgot_password'|trans }}</a>
    </div>

    <div class="login-lang-switcher" style="margin-top: 1.25rem; text-align: center; font-size: 0.8rem; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
        {% set locales = {'de': 'Deutsch', 'en': 'English', 'fr': 'Français'} %}
        {% for code, label in locales %}
            {% if not loop.first %}
                <span style="opacity: 0.4;">–</span>
            {% endif %}
            {% if app.request.locale == code %}
                <span class="login-lang-current" style="font-weight: 500;">{{ label }}</span>
            {% else %}
                <form action="{{ path('changeLocale', {'language': code}) }}" method="post" style="display: inline;">
                    <input type="hidden" name="token" value="{{ csrf_token('change-locale') }}" />
                    <button type="submit" class="login-lang-btn" style="background: none; border: none; cursor: pointer; font-size: 0.8rem; padding: 0;">{{ label }}</button>
                </form>
            {% endif %}
        {% endfor %}
    </div>

    {% if registration_enabled %}
        <div style="margin-top: 1rem; text-align: center; font-size: 0.875rem;">
            <a href="{{ path('fos_user_registration_register') }}" class="login-link">{{ 'security.login.register'|trans }}</a>
        </div>
    {% endif %}
{% endblock fos_user_content %}
